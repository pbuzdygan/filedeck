# Copy to .env and adjust. All values are optional.

# Released image instead of a local build, e.g. ghcr.io/pbuzdygan/filedeck:latest
# (main), :1.0.0, :dev_latest or :dev0.9.0 (dev). Update: docker compose pull && docker compose up -d
#FILEDECK_IMAGE=ghcr.io/pbuzdygan/filedeck:latest

# Address used in the browser. Must match exactly (Host is checked).
# For LAN access use the server IP/name and set FILEDECK_BIND=0.0.0.0.
#FILEDECK_ORIGIN=https://192.168.1.10:8443
#FILEDECK_BIND=0.0.0.0
#FILEDECK_PORT=8443

# UID:GID of the Filedeck process. When you map host directories (see
# compose.override.example.yaml) it must be allowed to write them, e.g. the
# uid/gid used in the SMB mount options. See README "Host directories (spaces)".
#FILEDECK_USER=1000:1000

# Modes for files/folders created through Filedeck (on SMB mounts the mount
# options decide instead).
#FILEDECK_FILE_MODE=0640
#FILEDECK_DIR_MODE=0750

# Behind a reverse proxy terminating TLS (Caddy, Traefik, nginx):
#FILEDECK_TLS_SELF_SIGNED=false
#FILEDECK_PROXY_CIDR=172.30.0.0/16
#FILEDECK_ORIGIN=https://files.example.org
