# Copy to .env and adjust. All values are optional.

# Released image instead of a local build, e.g. ghcr.io/pbuzdygan/filedeck:latest
# (main), :1.0.0, :dev_latest or :dev0.9.0 (dev). Update: docker compose pull && docker compose up -d
#FILEDECK_IMAGE=ghcr.io/pbuzdygan/filedeck:latest

# Address used in the browser. Must match exactly (Host is checked).
# For LAN access use the server IP/name and set FILEDECK_BIND=0.0.0.0.
#FILEDECK_ORIGIN=https://192.168.1.10:8443
#FILEDECK_BIND=0.0.0.0
#FILEDECK_PORT=8443

# UID:GID of the Filedeck process. When you map host directories (see
# compose.override.example.yaml) it must be allowed to write them, e.g. the
# uid/gid used in the SMB mount options. See README "Host directories (spaces)".
#FILEDECK_USER=1000:1000

# Modes for files/folders created through Filedeck (on SMB mounts the mount
# options decide instead).
#FILEDECK_FILE_MODE=0640
#FILEDECK_DIR_MODE=0750

# Key that encrypts two-factor (TOTP) secrets and recovery codes, so a copy of
# the data volume or a backup alone does not reveal them. Generate once with
#   openssl rand -base64 32
# and keep a copy outside the server: without it, two-factor authentication
# has to be reset (reset-2fa) for every user. Changing it later is refused.
# Alternatively FILEDECK_SECRET_KEY_FILE=/run/secrets/<name> (Docker secret).
#FILEDECK_SECRET_KEY=

# Behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik, nginx) that
# terminates TLS - two settings. The proxy then talks plain HTTP to Filedeck.
#FILEDECK_ORIGIN=https://files.example.org
#FILEDECK_PROXY_CIDR=
# FILEDECK_PROXY_CIDR is the address Filedeck sees the proxy connect from:
#  - proxy -> <server IP>:<FILEDECK_PORT> (published port): the gateway of
#    Filedeck's Docker network, e.g. 172.18.0.1/32;
#  - proxy container in the same Docker network -> filedeck:8443 (no ports
#    needed): the proxy container's address, e.g. 172.18.0.5/32.
# Not sure? Start it, open the site through the proxy and read the log:
# "untrusted_proxy ... set FILEDECK_PROXY_CIDR=..." tells the exact value.
